{
    servers {
        timeouts {
            read_header 10s
            read_body 15m
            write 15m
            idle 60s
        }
    }
}
yaboirar.web.id {
    request_body {
        max_size 550MiB
    }
    encode zstd gzip
    reverse_proxy 127.0.0.1:8000
}
www.yaboirar.web.id {
    redir https://yaboirar.web.id{uri} 308
}
